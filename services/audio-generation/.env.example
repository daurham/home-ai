# Copy this file outside the repository and keep the filled copy mode 600.
# Do not commit tokens, OAuth client files, model weights, or generated audio.

AUDIO_HOME=~/audio-service
AUDIO_BIND_HOST=127.0.0.1
AUDIO_PORT=8795
AUDIO_API_TOKEN=replace-with-a-long-random-token
AUDIO_BACKEND=acestep
AUDIO_MAX_QUEUE=8
AUDIO_MIN_DURATION_SECONDS=10
AUDIO_MAX_DURATION_SECONDS=180
AUDIO_MAX_GENERATION_ATTEMPTS=2
AUDIO_MAX_UPLOAD_ATTEMPTS=5
AUDIO_MIN_FREE_BYTES=8589934592
AUDIO_GENERATION_TIMEOUT=7200
AUDIO_INIT_TIMEOUT=1800

ACESTEP_ROOT=~/audio-service/vendor/ACE-Step-1.5
ACESTEP_PYTHON=~/audio-service/vendor/ACE-Step-1.5/.venv/bin/python
ACESTEP_PORT=8001
ACESTEP_API_KEY=replace-with-a-different-random-token
ACESTEP_CONFIG_PATH=acestep-v15-turbo
ACESTEP_INFERENCE_STEPS=8

AUDIO_GOOGLE_CLIENT_SECRETS=~/audio-service/google-client.json
AUDIO_GOOGLE_TOKEN=~/audio-service/data/google-token.json
AUDIO_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
AUDIO_DRIVE_PARENT_ID=
AUDIO_DRIVE_ENABLED=false

# Checkout of a client repository that contains audio-requests/ and audio-results/.
AUDIO_STUDIO_ROOT=
AUDIO_SYNC_ROOT=~/audio-service/data/studio-sync
AUDIO_GITHUB_BRANCH=
AUDIO_GITHUB_PUSH=false
# No password. Use 127.0.0.1, a private address, or 0.0.0.0 for the home LAN.
# Clients must be loopback, link-local, or RFC1918. Do not publish this port.
AUDIO_PREVIEW_BIND=127.0.0.1
AUDIO_PREVIEW_PORT=8796
AUDIO_FFMPEG=
