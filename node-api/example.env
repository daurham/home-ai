API_KEY=your-strong-api-key-here

# PostgreSQL Database Configuration
# These are used if DATABASE_URL is not set
POSTGRES_USER=homeai
POSTGRES_PASSWORD=homeai_password
POSTGRES_HOST=home-ai-postgres
POSTGRES_PORT=5432
POSTGRES_DB=homeai

# Or use a full connection string (takes precedence over individual vars above)
# DATABASE_URL=postgresql://homeai:homeai_password@home-ai-postgres:5432/homeai

# Household timezone for expense weeks (Friday 00:00 → Thursday 23:59:59.999).
# Default if unset: America/Phoenix.
EXPENSE_TIMEZONE=America/Phoenix

# Ollama. In Docker Compose this is overridden to http://home-ai-ollama:11434/api/generate.
# For local node-api (not in Compose), use the published host port:
# OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Latency Sparklines: edit node-api/latency-targets.js (allowlist only).
# Optional separate DB for postgres probes (otherwise use DATABASE_URL):
# MONITOR_DATABASE_URL=postgresql://homeai:homeai_password@home-ai-postgres:5432/homeai
