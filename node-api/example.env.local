API_KEY=your-dev-api-key-here

# PostgreSQL Database Configuration
# For local development, connect to your PostgreSQL instance
# Option 1: Connect to remote PostgreSQL on home-ai server
DATABASE_URL=postgresql://homeai:homeai_password@192.168.0.13:5433/homeai

# Option 2: Use local PostgreSQL
# DATABASE_URL=postgresql://homeai:homeai_password@localhost:5432/homeai

# Ollama Configuration (optional for dashboard development)
# If you're only working on dashboard features, you can leave this as-is
# The AI endpoints won't work, but database operations will
OLLAMA_URL=http://192.168.0.13:11434/api/generate
# Or if running Ollama locally:
# OLLAMA_URL=http://localhost:11434/api/generate

