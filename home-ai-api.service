[Unit]
Description=Home AI Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/daurham/home-ai
ExecStartPre=/bin/sh -c "until [ -S /var/run/docker.sock ]; do sleep 1; done"
ExecStart=/usr/bin/docker compose up -d --wait --wait-timeout 240
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300
User=daurham
Group=docker

[Install]
WantedBy=multi-user.target
