[Unit]
Description=go2rtc LAN restream for POE camera (independent of home-ai dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/daurham/home-ai/go2rtc
Environment=PATH=/home/daurham/home-ai/go2rtc/bin:/usr/bin:/bin
EnvironmentFile=/home/daurham/home-ai/go2rtc/.env
ExecStart=/home/daurham/home-ai/go2rtc/bin/go2rtc -c /home/daurham/home-ai/go2rtc/go2rtc.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
